# One Drive corpus, as this repository's own entry points read it: the census,
# the benchmark, the retrieval evaluation, the live tests and the example server.
# The library itself reads none of this; it takes a root folder and credentials
# as arguments (see `gdrive_scoped.env`).
#
#   cp .env.example .env      # .env is git-ignored
#
# `just` loads .env on its own; a variable already exported in the shell wins.
# An entry point run directly with `uv run python ...` does not, so export them
# first: `set -a; source .env; set +a`.
#
# Every entry point prints `identity: <address>` before anything else. Check it:
# a run as yourself instead of the deployment's identity enumerates everything
# you can see — measured at 9,878 folders in 10 pages for one developer account,
# against 123 in one page for a bot user granted the corpus folder alone.

# --- Which folder is the corpus -----------------------------------------------
# The folder ID from a https://drive.google.com/drive/folders/<id> URL. The
# alias `root` is refused: the whole of a Drive is not a corpus. This is the
# whole description — whether the folder is in My Drive or in a Shared Drive is
# measured from the folder's own metadata, not configured here (ADR 0011). The
# identity needs that folder shared with it, and nothing more: no query names a
# drive, so membership of a Shared Drive is not required either.
GDRIVE_ROOT_FOLDER_ID=
# How long a folder map keeps answering ancestry questions. Optional, default
# 60. 0 re-enumerates on every request. A folder moved out of the corpus keeps
# serving its contents for up to this long (ADR 0005).
#GDRIVE_FOLDER_MAP_TTL_SECONDS=60

# --- Who reaches Drive ---------------------------------------------------------
# A stored refresh token for the Drive Identity, scope drive.readonly only. Set
# all three or none of them: none falls back to Application Default Credentials
# (your own account, or GOOGLE_APPLICATION_CREDENTIALS), a partial triple is an
# error. Mint under an *Internal* OAuth consent screen — a token minted under
# Testing + External dies after seven days.
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
# Only for the ADC fallback, and only if the default lookup does not find it.
#GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/authorized_user.json

# --- Optional: what the tooling checks ----------------------------------------
# `just test-live` adds a search, a metadata revalidation and one bounded read
# when both are set. The source is a path relative to the root folder.
#GDRIVE_LIVE_SEARCH_QUERY=distinctive keywords
#GDRIVE_LIVE_EXPECTED_SOURCE=Nested Folder/Document.md
# `just evaluate` and `just benchmark`; these are the justfile's defaults.
#EVALUATION_FILE=evaluation/questions.local.json
#BENCHMARK_OUTPUT=_tmp/benchmark.json
#BENCHMARK_ITERATIONS=5
